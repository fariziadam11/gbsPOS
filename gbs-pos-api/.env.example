# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://gbspos:gbspos_secret@localhost:5432/gbs_pos?sslmode=disable
# SQL migrations (repo root migrations/). Leave empty to use GORM AutoMigrate.
MIGRATIONS_PATH=

# JWT Authentication (for ENABLE_DEMO_AUTH=true or dual auth mode)
# Must be at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRY_HOURS=24

# Keycloak Authentication (for Keycloak-only or dual auth mode)
# When both Keycloak and JWT are configured, set ENABLE_DEMO_AUTH=true for dual auth
KEYCLOAK_BASE_URL=https://auth.armmada.id
KEYCLOAK_REALM=gbs-pos

# Dual Auth Mode: When true, accepts BOTH JWT and Keycloak tokens
# When false, uses Keycloak only (if configured) or JWT only
ENABLE_DEMO_AUTH=true

# Comma-separated browser origins allowed for WebSocket connections.
# Empty keeps development compatibility; set this in production.
WS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=debug

# SumoPod QRIS Payment Gateway
# Sandbox URL: https://api-pay-sandbox.sumopod.com/api/v1
# Production URL: https://api-pay.sumopod.com/api/v1
SUMOPOD_API_URL=https://api-pay-sandbox.sumopod.com/api/v1
SUMOPOD_API_KEY=your_api_key_here
SUMOPOD_WEBHOOK_TOKEN=your_webhook_token_here
SUMOPOD_SUCCESS_URL=https://yourapp.com/payment/success
SUMOPOD_CANCEL_URL=https://yourapp.com/payment/cancel
SUMOPOD_EXPIRES_HOURS=24

# QRIS Direct (Static to Dynamic)
# Static QRIS string from your payment provider (Gojek/Gojek/OVO/etc)
QRIS_DIRECT_STATIC_QRIS=your_static_qris_string_here
QRIS_DIRECT_MERCHANT_NAME=Your Merchant Name
QRIS_DIRECT_MERCHANT_CITY=Your City
QRIS_DIRECT_PROVIDER=GoPay
QRIS_DIRECT_EXPIRES_MINUTES=15
QRIS_DIRECT_SKIP_CRC_VALIDATE=true
QRIS_DIRECT_AUTO_CONFIRM_DELAY_SECONDS=3
