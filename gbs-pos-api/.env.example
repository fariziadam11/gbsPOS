# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://gbspos:gbspos_secret@localhost:5432/gbs_pos?sslmode=disable
# SQL migrations (repo root migrations/). Leave empty to use GORM AutoMigrate.
MIGRATIONS_PATH=

# JWT (only required when ENABLE_DEMO_AUTH=true)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRY_HOURS=24

# Keycloak
KEYCLOAK_BASE_URL=https://auth.armmada.id
KEYCLOAK_REALM=gbs-pos
ENABLE_DEMO_AUTH=false

# Logging
LOG_LEVEL=debug

# SumoPod QRIS Payment Gateway
# Sandbox URL: https://api-pay-sandbox.sumopod.com/api/v1
# Production URL: https://api-pay.sumopod.com/api/v1
SUMOPOD_API_URL=https://api-pay-sandbox.sumopod.com/api/v1
SUMOPOD_API_KEY=your_api_key_here
SUMOPOD_WEBHOOK_TOKEN=your_webhook_token_here
SUMOPOD_SUCCESS_URL=https://yourapp.com/payment/success
SUMOPOD_CANCEL_URL=https://yourapp.com/payment/cancel
SUMOPOD_EXPIRES_HOURS=24
