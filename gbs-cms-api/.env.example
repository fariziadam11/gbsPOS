# Server
PORT=8081
ENV=development

# Database
DATABASE_URL=postgres://gbspos:gbspos_secret@localhost:5432/gbs_pos?sslmode=disable
# Leave empty to use GORM AutoMigrate.
MIGRATIONS_PATH=

# JWT Authentication (for ENABLE_DEMO_AUTH=true or dual auth mode)
# Must be at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRY_HOURS=24

# Keycloak Authentication (for Keycloak-only or dual auth mode)
# When both Keycloak and JWT are configured, set ENABLE_DEMO_AUTH=true for dual auth
KEYCLOAK_BASE_URL=https://auth.armmada.id
KEYCLOAK_REALM=gbs-pos

# Dual Auth Mode: When true, accepts BOTH JWT and Keycloak tokens
# When false, uses Keycloak only (if configured) or JWT only
ENABLE_DEMO_AUTH=true

# Logging
LOG_LEVEL=debug

# CMS Upload Directory
UPLOAD_DIR=./uploads/ads
