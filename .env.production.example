# ================================
# GBS POS & CMS - Production Environment
# ================================
# Copy this file to .env and fill in the values

# ===================
# Database Configuration
# ===================
DATABASE_URL=postgres://postgres:YOUR_SECURE_PASSWORD@postgres:5432/gbs_pos?sslmode=disable
POSTGRES_DB=gbs_pos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# ===================
# Dual Authentication Configuration
# ===================

# JWT Secret for local JWT tokens (HS256)
# MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY_MIN_32_CHARS

# JWT Token Expiry (in hours)
JWT_EXPIRY_HOURS=24

# Keycloak Configuration (for RS256 tokens)
# Leave empty to disable Keycloak auth
KEYCLOAK_BASE_URL=https://auth.armmada.id
KEYCLOAK_REALM=gbs-pos

# Dual Auth Mode: When true, accepts BOTH JWT and Keycloak tokens
# - true: Both JWT (HS256) and Keycloak (RS256) accepted
# - false: Only Keycloak accepted (if configured) or JWT only
ENABLE_DEMO_AUTH=true

# ===================
# API Configuration
# ===================
PORT_POS=8080
PORT_CMS=8081
ENV=production
LOG_LEVEL=info

# ===================
# Upload Configuration
# ===================
UPLOAD_DIR=/uploads/ads
MAX_UPLOAD_SIZE=52428800  # 50MB

# ===================
# CORS Configuration
# ===================
ALLOWED_ORIGINS=https://pos.armmada.id,https://cms.armmada.id

# ===================
# SumoPod QRIS Configuration
# ===================
# Production: https://api-pay.sumopod.com/api/v1
SUMOPOD_API_URL=https://api-pay.sumopod.com/api/v1
SUMOPOD_API_KEY=YOUR_SUMOPOD_API_KEY
SUMOPOD_WEBHOOK_TOKEN=YOUR_WEBHOOK_SECRET_TOKEN
SUMOPOD_SUCCESS_URL=https://pos.armmada.id/payment/success
SUMOPOD_CANCEL_URL=https://pos.armmada.id/payment/cancel
SUMOPOD_EXPIRES_HOURS=24

# ===================
# Database Connection Pool
# ===================
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ===================
# Monitoring (Optional)
# ===================
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090

# ===================
# Email Notifications (Optional)
# ===================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@armmada.id
