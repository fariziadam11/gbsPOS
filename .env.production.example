# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Database Configuration
DATABASE_URL=postgres://postgres:YOUR_SECURE_PASSWORD@postgres:5432/gbs_pos?sslmode=disable
POSTGRES_DB=gbs_pos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# JWT Configuration (MUST be at least 32 characters)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG

# API Configuration
PORT_POS=8080
PORT_CMS=8081
ENV=production
LOG_LEVEL=info

# Upload Configuration
UPLOAD_DIR=/uploads/ads

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=https://pos.gbs.com,https://cms.gbs.com

# Server Configuration
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
REQUEST_TIMEOUT=30s

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# Backup Configuration
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Email Notifications (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@gbs-pos.com

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=
