							"raw": "{{baseUrl}}/users",
							"host": ["{{baseUrl}}"],
							"path": ["users"]
						},
						"description": "Get list of all users (ADMIN only)"
					}
				},
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/:id",
							"host": ["{{baseUrl}}"],
							"path": ["users", ":id"]
						},
						"description": "Get a single user by ID (ADMIN only)"
					}
				},
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"newcashier\",\n    \"password\": \"password123\",\n    \"name\": \"New Cashier\",\n    \"role\": \"CASHIER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": ["{{baseUrl}}"],
							"path": ["users"]
						},
						"description": "Create a new user account (ADMIN only)"
					}
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Name\",\n    \"role\": \"CASHIER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/:id",
							"host": ["{{baseUrl}}"],
							"path": ["users", ":id"]
						},
						"description": "Update an existing user (ADMIN only)"
					}
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/:id",
							"host": ["{{baseUrl}}"],
							"path": ["users", ":id"]
						},
						"description": "Delete a user (ADMIN only)"
					}
				}
			]
		},
		{
			"name": "Settings",
			"item": [
				{
					"name": "Get All Settings",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": ["{{baseUrl}}"],
							"path": ["settings"]
						},
						"description": "Get all system settings (ADMIN only)"
					}
				},
				{
					"name": "Update Settings",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"storeName\": \"My Store\",\n    \"storeCode\": \"STORE01\",\n    \"address\": \"Jakarta\",\n    \"phone\": \"02112345678\",\n    \"email\": \"store@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": ["{{baseUrl}}"],
							"path": ["settings"]
						},
						"description": "Update system settings (ADMIN only)"
					}
				}
			]
		},
		{
			"name": "Cart Display",
			"item": [
				{
					"name": "Save Cart Display (POS)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"terminalId\": \"ANDROID-123456\",\n    \"deviceInfo\": {\n        \"model\": \"Samsung Galaxy S21\",\n        \"androidId\": \"android123456\",\n        \"ipAddress\": \"192.168.1.100\"\n    },\n    \"Initial\": {\n        \"NamaKasir\": \"CASHIER01\",\n        \"KodeToko\": \"T001\",\n        \"NamaToko\": \"Demo Store\",\n        \"JenisToko\": \"POINT\"\n    },\n    \"DaftarBelanja\": [\n        {\n            \"Nama\": \"Coffee Latte\",\n            \"Harga\": \"25000\",\n            \"Qty\": \"2\",\n            \"SubTotal\": \"50000\"\n        }\n    ],\n    \"Summary\": {\n        \"Hemat\": \"0\",\n        \"Total\": \"50000\",\n        \"Bayar\": \"60000\",\n        \"Kembali\": \"10000\"\n    },\n    \"TeksSelesai\": \"Terima Kasih\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/display/cart",
							"host": ["{{baseUrl}}"],
							"path": ["display", "cart"]
						},
						"description": "Upload cart display JSON from Android POS"
					}
				},
				{
					"name": "Get Cart Display (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/display/cart?terminalId=ANDROID-123456",
							"host": ["{{baseUrl}}"],
							"path": ["display", "cart"],
							"query": [
								{
									"key": "terminalId",
									"value": "ANDROID-123456"
								}
							]
						},
						"description": "Get cart display JSON for a terminal (Public - no auth required)"
					}
				},
				{
					"name": "List All Terminals",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/display/terminals",
							"host": ["{{baseUrl}}"],
							"path": ["display", "terminals"]
						},
						"description": "Get all stored cart displays with device info (ADMIN only)"
					}
				}
			]
		}
	]
}
