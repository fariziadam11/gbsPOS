# ================================
# GBS POS - Development Environment
# ================================

# ===================
# Database Configuration
# ===================
DATABASE_URL=postgres://gbspos:gbspos_secret@localhost:5432/gbs_pos?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# ===================
# Authentication
# ===================
JWT_SECRET=development_secret_key_minimum_32_characters_long
JWT_EXPIRY_HOURS=24
ENABLE_DEMO_AUTH=true

# Keycloak (kosongkan untuk development)
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=

# ===================
# Server Configuration
# ===================
PORT=8080
ENV=development
LOG_LEVEL=debug

# ===================
# Upload Configuration
# ===================
UPLOAD_DIR=./uploads/ads

# ===================
# SumoPod QRIS (Gateway Mode)
# ===================
SUMOPOD_API_URL=https://api-pay-sandbox.sumopod.com/api/v1
SUMOPOD_API_KEY=your_sandbox_api_key
SUMOPOD_WEBHOOK_TOKEN=your_webhook_token
SUMOPOD_SUCCESS_URL=http://localhost:5173/payment/success
SUMOPOD_CANCEL_URL=http://localhost:5173/payment/cancel
SUMOPOD_EXPIRES_HOURS=24

# ===================
# QRIS Direct (Static to Dynamic)
# ===================
# QRIS Static string - ini QRIS Gojek/Mama Tari contoh
# Ganti dengan QRIS static dari payment provider Anda
QRIS_DIRECT_STATIC_QRIS=00020101021126610014COM.GO-JEK.WWW01189360091434374848210210G4374848210303UMI51440014ID.CO.QRIS.WWW0215ID10265153412990303UMI5204581253033605802ID5925Snack Kering Mama Tari, K6013JAKARTA PUSAT61051064062140703A01110362163042807

# Merchant info (sesuaikan dengan QRIS Anda)
QRIS_DIRECT_MERCHANT_NAME=Snack Kering Mama Tari, K
QRIS_DIRECT_MERCHANT_CITY=JAKARTA PUSAT
QRIS_DIRECT_PROVIDER=GoPay

# Expiry time dalam menit
QRIS_DIRECT_EXPIRES_MINUTES=15

# Skip CRC validation (true untuk Gojek/OVO)
QRIS_DIRECT_SKIP_CRC_VALIDATE=true
