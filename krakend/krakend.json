{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "gbs-pos-cms-gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "endpoints": [
    {
      "endpoint": "/pos/v1/products",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization"
      ],
      "backend": [
        {
          "host": [
            "http://pos-api:8080"
          ],
          "url_pattern": "/v1/products",
          "method": "GET",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/pos/v1/orders",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization"
      ],
      "backend": [
        {
          "host": [
            "http://pos-api:8080"
          ],
          "url_pattern": "/v1/orders",
          "method": "GET",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/pos/v1/customers",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization"
      ],
      "backend": [
        {
          "host": [
            "http://pos-api:8080"
          ],
          "url_pattern": "/v1/customers",
          "method": "GET",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/cms/v1/ads",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization"
      ],
      "backend": [
        {
          "host": [
            "http://cms-api:8081"
          ],
          "url_pattern": "/v1/ads",
          "method": "GET",
          "encoding": "no-op"
        }
      ]
    }
  ]
}
